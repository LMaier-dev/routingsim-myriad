	echo $*	| sed -E "s#n([0-9]+)_m([0-9]+)_p([0-9]+\.?[0-9]*)_seed([0-9]+)#./scripts/graphgen.py --seed \4 -d $(TOPODIR) plc \1 \2 \3#" | bash

