$(TOPODIR)/clos_fat_tree_%_without_hosts.txt:
	./scripts/graphgen.py -d $(TOPODIR) cft $*

$(TOPODIR)/clos_fat_tree_%_with_hosts.txt:
	./scripts/graphgen.py -d $(TOPODIR) cft $* --hosts


realTopo: $(TOPODIR)/KentuckyDataLink.graphml.txt
$(TOPODIR)/KentuckyDataLink.graphml:
    wget http://topology-zoo.org/files/Kdl.graphml -O  $(TOPODIR)/KentuckyDataLink.graphml

$(TOPODIR)/%.graphml.txt:
    /scripts/graphgen.py -d $(TOPODIR) graphml  $(TOPODIR)/$*.graphml
